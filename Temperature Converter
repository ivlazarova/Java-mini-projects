import java.util.Scanner;

class Main{
    public static void main(String[] args){

        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the tempreture: ");
        double tempreture = scanner.nextDouble();
        scanner.nextLine();
        System.out.print("Enter the scale: (C, F, K) - ");
        String scale = scanner.nextLine();
        System.out.print("Enter the wanted scale: (C, F, K) - ");
        String wantedScale = scanner.nextLine();

        double scaleToCels = 0.0;
        if(scale.equals("C")){
            scaleToCels += tempreture;
        }
        else if(scale.equals("F")){
            scaleToCels = (tempreture - 32) * 5.0/9.0;
        }
        else if(scale.equals("K")){
            scaleToCels = tempreture - 273.15;
        }
        else{
            System.out.println("Error.Enter one of the written above scales.");
        }

        double result = 0.0;
        if(wantedScale.equals("C")){
            result = scaleToCels;
        }
        else if(wantedScale.equals("F")){
            result = scaleToCels * 9.0/5.0 + 32;
        }
        else if(wantedScale.equals("K")){
            result = scaleToCels + 273.15;
        }
        else{
            System.out.println("Error. Unknown scale. Enter one from the above.");
        }

        System.out.printf("%.2f %s = %.2f %s", tempreture, scale, result, wantedScale);

        scanner.close();
    }
}
