public class Book{
    String title;
    String author;
    static int totalBooks = 0;
    static int totalBorrowed = 0;
    boolean isBorrowed;

    Book(String title, String author){
        this.title = title;
        this.author = author;
        this.isBorrowed = false;
        totalBooks++;
    }

    void borrowBook(){
        if(!isBorrowed){
            isBorrowed = true;
            totalBorrowed++;
            System.out.println(title + " has been borrowed.");
        }
        else{
            System.out.println(title + " is already borrowed.");
        }
    }

    void returnBook(){
        if(isBorrowed){
            isBorrowed = false;
            totalBorrowed--;
            System.out.println(title + " has been reeturned.");
        }
        else{
            System.out.println(title + " was not borrowed.");
        }
    }
    static void printLibrary(){
    System.out.println("===== Library statistic =====");
    System.out.println("Total books in the library: " + totalBooks);
    System.out.println("Books currently borrowed: " + totalBorrowed);
    System.out.println("Available books: " + (totalBooks - totalBorrowed));
}
}
